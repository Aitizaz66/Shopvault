NODE_ENV=development
PORT=5000
# Transactions require MongoDB Atlas or another replica set, including local development.
MONGODB_URI=mongodb://127.0.0.1:27017/shopvault?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional extra exact origins, separated by commas. No wildcards.
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1
# Optional: enable multipart uploads. Hosted image URLs work without Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
